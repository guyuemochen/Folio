{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window + user-manual window",
  "windows": ["main", "manual"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    "shell:allow-open",
    "dialog:default",
    "updater:default",
    "process:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/plugins/**" },
        { "path": "$APPDATA/plugin-storage/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APPDATA/plugins/**" },
        { "path": "$APPDATA/plugin-storage/**" }
      ]
    }
  ]
}
